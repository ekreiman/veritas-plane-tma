# Copy to .env (gitignored) and fill in real values. Never commit real
# secrets — this file only documents which env vars the service needs.

# Uvicorn bind port. Kai's Caddyfile (TLV-2682) upstreams to 127.0.0.1:8081.
# Overridable via env — used by the launch invocation on Halcyon.
PORT=8081

# Telegram bot token from @BotFather. Required to validate initData HMACs.
TELEGRAM_BOT_TOKEN=

# HMAC signing secret for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required — the service refuses to start a login flow without this set.
TMA_SESSION_SECRET=

# Per-person Plane API tokens, one env var per entry in
# auth/telegram_user_map.py's plane_token_env_var field. Add one line per
# mapped human as the roster grows (TLV-2677).
PLANE_TOKEN_WERNER=
